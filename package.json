{
  "name": "minicrm-backend",
  "private": true,
  "description": "Backend do Mini CRM: microsserviços em Azure Functions organizados com Vertical Slice e Clean Architecture",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint:dependencias": "depcruise pacotes servicos bff --config .dependency-cruiser.cjs",
    "build": "pnpm -r run build",
    "verificar": "pnpm typecheck && pnpm lint:dependencias && pnpm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.6.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
